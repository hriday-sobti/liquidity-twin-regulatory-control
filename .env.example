# Liquidity Twin Environment Configuration
# System Context: Regulatory Liquidity Digital Twin, Control Graph and Reporting Compiler

ENVIRONMENT=development
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration (Defaults to SQLite for instant local execution without external daemons)
# For production PostgreSQL: postgresql+psycopg://postgres:postgres@localhost:5432/liquidity_twin
DATABASE_URL=sqlite:///./liquidity_twin.db

# Versioning and Provenance
CALCULATION_VERSION=3.2.0
RULE_VERSION=3.2.0
DATASET_VERSION=1.0.0
RANDOM_SEED=42

# AI Copilot Configuration (Optional LLM enhancement; deterministic fallback active by default)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_VERIFIER_STRICT_MODE=true
